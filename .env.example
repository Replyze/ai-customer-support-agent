# Copy to .env and fill in. The CLI reads .env from the folder you run it in;
# variables already set in your shell win.

# Your Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# The model that decides. Default: claude-haiku-5-5
SUPPORT_AGENT_MODEL=claude-haiku-5-5

# How much the model thinks: low, medium, high, xhigh or max. Default: medium.
# Leave it empty for a model that doesn't take the effort setting.
SUPPORT_AGENT_EFFORT=medium

# Your help articles, and the business name the agent speaks for.
SUPPORT_AGENT_DOCS=examples/shop-docs
SUPPORT_AGENT_COMPANY=Larkspur Outdoor

# Log level for the agent's warnings (model errors and the like).
SUPPORT_AGENT_LOG=WARNING
